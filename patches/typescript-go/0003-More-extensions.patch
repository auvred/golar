diff --git a/_packages/native-preview/src/api/node/node.generated.ts b/_packages/native-preview/src/api/node/node.generated.ts
index ff74677b3..915251b8c 100644
--- a/_packages/native-preview/src/api/node/node.generated.ts
+++ b/_packages/native-preview/src/api/node/node.generated.ts
@@ -32,6 +32,7 @@ import {
     NODE_OFFSET_KIND,
     NODE_OFFSET_NEXT,
     NODE_OFFSET_PARENT,
+    NODE_OFFSET_POINTER,
     NODE_OFFSET_POS,
 } from "./protocol.ts";
 
@@ -920,4 +921,12 @@ export class RemoteNode extends RemoteNodeBase implements Node {
         }
         return flags;
     }
+
+    get pointerHi(): number {
+        return this.view.getUint32(this._byteIndex + NODE_OFFSET_POINTER + 4, true);
+    }
+
+    get pointerLo(): number {
+        return this.view.getUint32(this._byteIndex + NODE_OFFSET_POINTER, true);
+    }
 }
diff --git a/_packages/native-preview/src/api/node/protocol.ts b/_packages/native-preview/src/api/node/protocol.ts
index b21098cc2..70ec52971 100644
--- a/_packages/native-preview/src/api/node/protocol.ts
+++ b/_packages/native-preview/src/api/node/protocol.ts
@@ -13,7 +13,7 @@ export const HEADER_OFFSET_STRUCTURED_DATA = 36;
 export const HEADER_OFFSET_NODES = 40;
 export const HEADER_SIZE = 44;
 
-export const NODE_LEN = 28;
+export const NODE_LEN = 36;
 
 export const NODE_OFFSET_KIND = 0;
 export const NODE_OFFSET_POS = 4;
@@ -22,6 +22,7 @@ export const NODE_OFFSET_NEXT = 12;
 export const NODE_OFFSET_PARENT = 16;
 export const NODE_OFFSET_DATA = 20;
 export const NODE_OFFSET_FLAGS = 24;
+export const NODE_OFFSET_POINTER = 28;
 
 export const KIND_NODE_LIST = 0xFFFFFFFF;
 
diff --git a/_scripts/generate-encoder.ts b/_scripts/generate-encoder.ts
index caddf3356..01fe29dec 100644
--- a/_scripts/generate-encoder.ts
+++ b/_scripts/generate-encoder.ts
@@ -5,8 +5,8 @@
  * Usage: node --experimental-strip-types _scripts/generate-encoder.ts
  *
  * Generates:
- *   - internal/api/encoder/encoder_generated.go
- *   - internal/api/encoder/decoder_generated.go
+ *   - pkg/api/encoder/encoder_generated.go
+ *   - pkg/api/encoder/decoder_generated.go
  *   - _packages/native-preview/src/api/node/protocol.generated.ts
  */
 
@@ -349,7 +349,7 @@ function generateGoEncoder(): string {
     w.push();
     w.write('"fmt"');
     w.write("");
-    w.write('"github.com/microsoft/typescript-go/internal/ast"');
+    w.write('"github.com/microsoft/typescript-go/pkg/ast"');
     w.pop();
     w.write(")");
     w.write("");
@@ -596,7 +596,7 @@ function generateGoDecoder(): string {
     w.push();
     w.write('"fmt"');
     w.write("");
-    w.write('"github.com/microsoft/typescript-go/internal/ast"');
+    w.write('"github.com/microsoft/typescript-go/pkg/ast"');
     w.pop();
     w.write(")");
     w.write("");
@@ -1495,6 +1495,7 @@ function emitNodeGeneratedImports(w: CodeWriter) {
     w.write(`    NODE_OFFSET_NEXT,`);
     w.write(`    NODE_OFFSET_PARENT,`);
     w.write(`    NODE_OFFSET_POS,`);
+    w.write(`    NODE_OFFSET_POINTER,`);
     w.write(`} from "./protocol.ts";`);
     w.write(`import {`);
     w.write(`    type NodeDataType,`);
@@ -1966,6 +1967,14 @@ function emitRemoteNodeClassClose(w: CodeWriter) {
     w.write(`        }`);
     w.write(`        return flags;`);
     w.write(`    }`);
+    w.write(``);
+    w.write(`    get pointerHi(): number {`);
+    w.write(`        return this.view.getUint32(this._byteIndex + NODE_OFFSET_POINTER + 4, true);`);
+    w.write(`    }`);
+    w.write(``);
+    w.write(`    get pointerLo(): number {`);
+    w.write(`        return this.view.getUint32(this._byteIndex + NODE_OFFSET_POINTER, true);`);
+    w.write(`    }`);
     w.write(`}`);
 }
 
@@ -1990,14 +1999,14 @@ export default function main() {
 
     const goEncoder = generateGoEncoder();
     writeAndFormat(
-        path.join(ROOT, "internal/api/encoder/encoder_generated.go"),
+        path.join(ROOT, "pkg/api/encoder/encoder_generated.go"),
         goEncoder + "\n",
         "dprint fmt",
     );
 
     const goDecoder = generateGoDecoder();
     writeAndFormat(
-        path.join(ROOT, "internal/api/encoder/decoder_generated.go"),
+        path.join(ROOT, "pkg/api/encoder/decoder_generated.go"),
         goDecoder + "\n",
         "dprint fmt",
     );

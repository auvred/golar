diff --git a/packages/typescript/src/api/node/node.generated.ts b/packages/typescript/src/api/node/node.generated.ts
index 0f69dbc63a..7757ed29ad 100644
--- a/packages/typescript/src/api/node/node.generated.ts
+++ b/packages/typescript/src/api/node/node.generated.ts
@@ -35,6 +35,7 @@ import {
     NODE_OFFSET_KIND,
     NODE_OFFSET_NEXT,
     NODE_OFFSET_PARENT,
+    NODE_OFFSET_POINTER,
     NODE_OFFSET_POS,
 } from "./protocol.ts";
 
@@ -976,4 +977,12 @@ export class RemoteNode extends RemoteNodeBase implements Node {
         }
         return flags;
     }
+
+    get pointerHi(): number {
+        return this.view.getUint32(this._byteIndex + NODE_OFFSET_POINTER + 4, true);
+    }
+
+    get pointerLo(): number {
+        return this.view.getUint32(this._byteIndex + NODE_OFFSET_POINTER, true);
+    }
 }

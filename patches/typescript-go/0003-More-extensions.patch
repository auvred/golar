  *
  * Generates:
- *   - internal/api/encoder/encoder_generated.go
- *   - internal/api/encoder/decoder_generated.go
+ *   - pkg/api/encoder/encoder_generated.go
+ *   - pkg/api/encoder/decoder_generated.go
  *   - packages/typescript/src/api/node/protocol.generated.ts
  */
 
@@ -1500,6 +1500,7 @@ function emitNodeGeneratedImports(w: CodeWriter) {
     w.write(`    NODE_OFFSET_NEXT,`);
     w.write(`    NODE_OFFSET_PARENT,`);
     w.write(`    NODE_OFFSET_POS,`);
+    w.write(`    NODE_OFFSET_POINTER,`);
     w.write(`} from "./protocol.ts";`);
     w.write(`import {`);
     w.write(`    type NodeDataType,`);
@@ -2038,6 +2039,14 @@ function emitRemoteNodeClassClose(w: CodeWriter) {
     w.write(`        }`);
     w.write(`        return flags;`);
     w.write(`    }`);
+    w.write(``);
+    w.write(`    get pointerHi(): number {`);
+    w.write(`        return this.view.getUint32(this._byteIndex + NODE_OFFSET_POINTER + 4, true);`);
+    w.write(`    }`);
+    w.write(``);
+    w.write(`    get pointerLo(): number {`);
+    w.write(`        return this.view.getUint32(this._byteIndex + NODE_OFFSET_POINTER, true);`);
+    w.write(`    }`);
     w.write(`}`);
 }
 

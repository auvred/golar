{
	"packageManager": "pnpm@11.9.0",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"version": "0.1.9",
	"scripts": {
		"check": "golar",
		"format": "prettier -w . && go fmt ./cmd/... ./internal/... ./plugin/... && cd packages/astro && go fmt . && cargo fmt --all",
		"build:packages": "tsdown",
		"build:golar": "node ./tools/build.ts",
		"build:typescript-lite": "pnpm -C packages/vue build-typescript-lite"
	},
	"devDependencies": {
		"@types/node": "^25.9.4",
		"detect-libc": "^2.1.2",
		"golar": "workspace:*",
		"nano-spawn": "^2.1.0",
		"prettier": "^3.8.4",
		"tar": "^7.5.16",
		"tsdown": "^0.22.3",
		"valibot": "^1.4.1",
		"vitest": "^4.1.9"
	}
}
